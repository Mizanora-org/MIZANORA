{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "crons": [
    {
      "path": "/api/cron/security",
      "schedule": "0 2 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": true
  }
}
