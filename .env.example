# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://mizanora.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=923062015326
# 0 = free delivery. Set e.g. 250 to charge Rs. 250 delivery.
NEXT_PUBLIC_SHIPPING_FEE=250
NEXT_PUBLIC_FACEBOOK_URL=
# Optional text for the gold announcement bar
NEXT_PUBLIC_ANNOUNCEMENT=
# Google Search Console "HTML tag" verification: paste only the content="..." value
NEXT_PUBLIC_GSC_VERIFICATION=

# ===== Firebase (Project settings > General > Your apps > Web app) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin login email(s), comma separated (Google or email login)
NEXT_PUBLIC_ADMIN_EMAIL=

# ===== Firebase Admin (Project settings > Service accounts > Generate new private key) =====
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value in double quotes, keeping the \n characters
FIREBASE_PRIVATE_KEY=
# The UID of the admin user (Authentication > Users > User UID)
ADMIN_UID=

# ===== Image upload (ImgBB: imgbb.com > About > API) =====
# Server-only secret. Never put this in GitHub or in a NEXT_PUBLIC_ variable.
IMGBB_API_KEY=

# ===== Meta (Facebook/Instagram) =====
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager > Settings > Conversions API > Generate access token
META_CAPI_TOKEN=
# Optional: only while testing in Events Manager > Test events
META_TEST_EVENT_CODE=

# Optional: Google Gemini key for AI search (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Background music (optional fallback links) ---
# Music is edited in Admin > Music. It uses Firestore until an Admin > Data public snapshot is deployed; then it uses repo files.
# These variables are only a fallback for when Firebase is not set up.
# A DIRECT audio file link (.mp3, .m4a, .ogg or .wav) - a web page link will not play.
# NEXT_PUBLIC_APP_MUSIC_URL=https://res.cloudinary.com/.../mizanora-theme.mp3
# NEXT_PUBLIC_REEL_MUSIC_URL=https://res.cloudinary.com/.../reels-theme.mp3

# Easiest way to connect the server to Firebase: paste the WHOLE service-account JSON here instead of the two lines above
FIREBASE_SERVICE_ACCOUNT=

# Optional: delivery is free when the cart subtotal reaches this amount (0 = off). Needs NEXT_PUBLIC_SHIPPING_FEE above 0.
NEXT_PUBLIC_FREE_SHIPPING_OVER=0

# Season theme: autumn (default) | auto | winter | spring | summer | off
NEXT_PUBLIC_SEASON_THEME=auto
# Hijri date offset in days (Pakistan is usually -1 compared with Saudi Arabia)
NEXT_PUBLIC_HIJRI_OFFSET=-1

# ===== Payments (optional). Cash on delivery is always on. Add an account to switch a method on. Format: number|account title|bank =====
# NEXT_PUBLIC_PAY_EASYPAISA=03XXXXXXXXX|Your account title
# NEXT_PUBLIC_PAY_JAZZCASH=03XXXXXXXXX|Your account title
# NEXT_PUBLIC_PAY_BANK=PK00XXXX0000000000000000|Your account title|Bank name   (IBAN or Raast ID)
# Optional discount (0-15 %) for paying before delivery. It protects you from failed COD deliveries.
NEXT_PUBLIC_PREPAID_PERCENT=0

# --- AI assistant (Google Gemini) ---
# Easiest: add keys in the admin panel (/admin/assistant). Optional extra keys here (comma separated, all are used in turn):
# GEMINI_API_KEYS=AQ.xxxx,AQ.yyyy   (several keys, comma separated; new AI Studio keys start with AQ. and old ones with AIza, both work)
# Stable, private secret for assistant discounts/negotiation. Required for multi-instance deployments unless Firebase server credentials are configured. Never use a public/default key.
# DEAL_SECRET=long-unique-random-text


# ===== Ads API (v31/v32) =====
# Ads API keys are created in Admin > Ads API. Production tracking needs a stable AD_SECRET
# (or a configured private Firebase service-account secret); no public default is used.
# AD_SECRET=any-long-random-text  # strongly recommended; otherwise server-only Firebase credentials sign tokens
# Optional: extra shop domains allowed to run the shop's own ads (key=self), comma separated.
# The main NEXT_PUBLIC_SITE_URL domain works; an arbitrary request Host cannot authorize shop ads.
# NEXT_PUBLIC_EXTRA_HOSTS=www.yourshop.com

# ===== Image relay (v32) - /api/img =====
# When a supplier CDN refuses the browser (hotlink protection, expired link, http://),
# the shop retries the SAME photo through /api/img. https only, private hosts refused,
# images only, 8 MB cap, cached 30 days. No setup needed.
# Optional: restrict which hosts the relay may reach (comma separated, *.domain allowed):
# NEXT_IMAGE_PROXY_HOSTS=digitaloceanspaces.com,i.ibb.co,res.cloudinary.com

# ---- Product archive (optional, for big catalogues; see UPGRADE-v10.md) ----
# Lets Admin > Archive and Admin > Import save product files into your repository in one click.
# GITHUB_TOKEN=github_pat_xxx      fine-grained token, only this repository, Contents: Read and write
# GITHUB_REPO=yourname/mizanora
# GITHUB_BRANCH=main

# v33 - GITHUB ON THE WEBSITE (all optional; the public API needs no token)
# GITHUB_USER=muaaziqbalvip                the account shown on /muaaz-iqbal and /team
# GITHUB_PINNED=MIZANORA,asaan-lang,BarakatWave-TV   these repositories are shown first
# GITHUB_CACHE_SECONDS=1800                how long one GitHub answer is reused (min 300)
# NEXT_PUBLIC_GITHUB_URL=https://github.com/muaaziqbalvip   the footer / connect icon
# STORE_WINDOW=2500                how many of the newest live products the home page / feeds keep in memory

# ---- Realtime Database (visitor tracking, live users, order backup, shut-down switch; see UPGRADE-v11.md) ----
# Create it in Firebase Console > Build > Realtime Database, publish database.rules.json as its rules.
# Only needed if the address is NOT https://YOUR-PROJECT-default-rtdb.firebaseio.com
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# --- v14 additions -----------------------------------------------------------------------------
# Instant search-engine discovery (Bing, Yandex, Seznam...). 16 to 64 letters/numbers. Optional.
INDEXNOW_KEY=
# How many of the newest archived products take part in the home page shelves (default 4000, in-memory, 0 Firestore reads).
HOME_WINDOW=4000

# ===== Live TV (/live): optional local demo =====
# 0 = normal production behaviour: /live is off until Admin > Live TV saves channels.
# 1 = demo mode ONLY when Firebase is not configured or the admin has not saved channels: /live shows two public
#     HLS test streams, clearly labelled DEMO. It never overrides saved channels.
MZ_TV_DEMO=0

# ===== Movies & Series (/movies): IMDb via Cinemeta (zero key) =====
# v54: every film/series comes from IMDb (Cinemeta). No catalogue to fill in — an IMDb id is the page.
# Optional: TMDB_API_KEY (https://www.themoviedb.org/settings/api) only adds extra art when Cinemeta is slow.
TMDB_API_KEY=

# v54: how many titles /sitemaps/movies-*.xml should cover (1,000 - 500,000).
# Leave it unset: with data/imdb-ids.txt present the limit is 500,000, otherwise 20,000 (catalogue crawl).
# Build the list with `npm run imdb:ids` (the weekly GitHub Action does it for you).
MOVIES_SITEMAP_LIMIT=

# ===== Songs (/songs): optional private mirror =====
# The public JioSaavn-style mirrors are tried automatically. Set this to put your own mirror first:
# it is raced with saavn.dev and jiosavan-api2.vercel.app, fastest answer wins.
SONGS_API_BASE=

# ===== Live Channel: YouTube cast (optional — Admin > Live Channel > YouTube) =====
# Google Cloud project with YouTube Data API v3 + YouTube Live Streaming API enabled,
# OAuth client (Desktop) + refresh token (see UPGRADE-v27.md).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# v29: a long random text (24+ chars). Same value as the GitHub secret CAST_TOKEN. Lets the cast script fetch the stream key saved in the admin panel.
CAST_TOKEN=
# GitHub Actions secrets (not Vercel): YOUTUBE_STREAM_KEY (from the created broadcast),
# LIVE_CHANNEL_API (the site origin, default https://mizanora.vercel.app).

# ===== Security / private telemetry =====
# Server-only. Required for daily security-log retention on Vercel; use a random long secret.
# CRON_SECRET=
# Optional HMAC key for anonymous analytics presence IDs (otherwise the Admin service key is used).
# TELEMETRY_SECRET=
# Only on a reverse proxy that you CONTROL. On Vercel proxy headers are trusted automatically.
# TRUST_PROXY_HEADERS=0
# Optional: legacy Firestore rules-based admin verification. Default off; prefer ADMIN_UID above.
# ADMIN_RULES_FALLBACK=0
# Public /api/img relay destination allowlist, comma separated (recommended).
# NEXT_IMAGE_PROXY_HOSTS=i.ibb.co,res.cloudinary.com
